<Window x:Class="ScopeTrace.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=ValueBox}">
    <StackPanel Margin="16" Width="340">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" />
        <TextBox x:Name="ValueBox" Padding="4,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
