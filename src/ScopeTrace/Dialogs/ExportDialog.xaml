<Window x:Class="ScopeTrace.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Width="460">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

        <TextBlock Text="Formats" FontWeight="SemiBold" Margin="0,0,0,4" />
        <CheckBox x:Name="PngBox" Margin="0,2">
            <TextBlock>PNG image <Run Foreground="{StaticResource SubtleTextBrush}">— lossless, rendered from the vectors at high resolution</Run></TextBlock>
        </CheckBox>
        <CheckBox x:Name="SvgBox" Margin="0,2">
            <TextBlock>SVG vector <Run Foreground="{StaticResource SubtleTextBrush}">— exact geometry, scales to any size</Run></TextBlock>
        </CheckBox>
        <CheckBox x:Name="HpglBox" Margin="0,2">
            <TextBlock>HP-GL original (.plt) <Run Foreground="{StaticResource SubtleTextBrush}">— the exact bytes the scope sent</Run></TextBlock>
        </CheckBox>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Colors" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeBox" Grid.Column="1" Margin="0,2">
                <ComboBoxItem Content="Current theme" />
                <ComboBoxItem Content="CRT (green on black)" />
                <ComboBoxItem Content="Paper (gray on white)" />
            </ComboBox>
            <TextBlock Text="Image size" Grid.Row="1" VerticalAlignment="Center" ToolTip="PNG only. Same picture, just more pixels: bigger stays sharp when zoomed or printed large." />
            <ComboBox x:Name="SizeBox" Grid.Row="1" Grid.Column="1" Margin="0,2">
                <ComboBoxItem Content="Small: for sharing and documents" Tag="2000" />
                <ComboBoxItem Content="Medium (recommended)" Tag="4000" />
                <ComboBoxItem Content="Large: for big prints and zooming" Tag="8000" />
            </ComboBox>
        </Grid>

        <TextBlock Text="Folder" FontWeight="SemiBold" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Padding="10,2" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" Padding="4,3" />
        </DockPanel>
        <CheckBox x:Name="OpenFolderBox" Content="Open the folder when done" Margin="0,10,0,0" IsChecked="True" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Export" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
