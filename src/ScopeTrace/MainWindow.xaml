<Window x:Class="ScopeTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScopeTrace"
        xmlns:controls="clr-namespace:ScopeTrace.Controls"
        xmlns:vm="clr-namespace:ScopeTrace.ViewModels"
        Title="HP ScopeTrace" Icon="Assets/ScopeTrace.ico" Width="1280" Height="800" MinWidth="820" MinHeight="520"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource ChromeBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:ListenerStateToBrushConverter x:Key="StateToBrush" />

        <ContextMenu x:Key="CaptureMenu">
            <MenuItem Command="{x:Static local:AppCommands.ExportSelected}" Header="Export selected…" />
            <MenuItem Command="{x:Static local:AppCommands.ExportAll}" Header="Export all…" />
            <MenuItem Command="{x:Static local:AppCommands.CopyImage}" />
            <Separator />
            <MenuItem Command="{x:Static local:AppCommands.SelectAll}" />
            <MenuItem Command="{x:Static local:AppCommands.Rename}" />
            <MenuItem Header="Rotate">
                <MenuItem Command="{x:Static local:AppCommands.RotateAuto}" />
                <MenuItem Command="{x:Static local:AppCommands.RotateLeft}" />
                <MenuItem Command="{x:Static local:AppCommands.RotateRight}" />
            </MenuItem>
            <Separator />
            <MenuItem Command="{x:Static local:AppCommands.Delete}" Header="Delete selected" />
        </ContextMenu>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:AppCommands.Import}" Executed="Import_Executed" />
        <CommandBinding Command="{x:Static local:AppCommands.ExportSelected}" Executed="ExportSelected_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.ExportAll}" Executed="ExportAll_Executed" CanExecute="HasCaptures_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.SelectAll}" Executed="SelectAll_Executed" CanExecute="HasCaptures_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.Rename}" Executed="Rename_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.Delete}" Executed="Delete_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.CopyImage}" Executed="CopyImage_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.RotateLeft}" Executed="RotateLeft_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.RotateRight}" Executed="RotateRight_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.RotateAuto}" Executed="RotateAuto_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.FullScreen}" Executed="FullScreen_Executed" />
        <CommandBinding Command="{x:Static local:AppCommands.ExitFullScreen}" Executed="ExitFullScreen_Executed" />
        <CommandBinding Command="{x:Static local:AppCommands.Replay}" Executed="Replay_Executed" />
        <CommandBinding Command="{x:Static local:AppCommands.Settings}" Executed="Settings_Executed" CanExecute="NotListening_CanExecute" />
        <CommandBinding Command="{x:Static local:AppCommands.ScopeSetup}" Executed="ScopeSetup_Executed" />
        <CommandBinding Command="{x:Static local:AppCommands.About}" Executed="About_Executed" />
        <CommandBinding Command="{x:Static local:AppCommands.Exit}" Executed="Exit_Executed" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu x:Name="MenuBar" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Command="{x:Static local:AppCommands.Import}" />
                <Separator />
                <MenuItem Command="{x:Static local:AppCommands.ExportSelected}" />
                <MenuItem Command="{x:Static local:AppCommands.ExportAll}" />
                <Separator />
                <MenuItem Command="{x:Static local:AppCommands.Exit}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Command="{x:Static local:AppCommands.SelectAll}" />
                <MenuItem Command="{x:Static local:AppCommands.Rename}" />
                <MenuItem Command="{x:Static local:AppCommands.CopyImage}" />
                <Separator />
                <MenuItem Command="{x:Static local:AppCommands.Delete}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="CRT theme (green on black)" IsCheckable="True" IsChecked="{Binding IsCrtTheme}" />
                <MenuItem Header="Paper theme (gray on white)" IsCheckable="True" IsChecked="{Binding IsPaperTheme}" />
                <Separator />
                <MenuItem Command="{x:Static local:AppCommands.RotateAuto}" />
                <MenuItem Command="{x:Static local:AppCommands.RotateLeft}" />
                <MenuItem Command="{x:Static local:AppCommands.RotateRight}" />
                <Separator />
                <MenuItem Command="{x:Static local:AppCommands.FullScreen}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Command="{x:Static local:AppCommands.Replay}" />
                <Separator />
                <MenuItem Command="{x:Static local:AppCommands.Settings}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Command="{x:Static local:AppCommands.ScopeSetup}" />
                <MenuItem Command="{x:Static local:AppCommands.About}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border x:Name="ToolbarBar" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Port" Style="{StaticResource Caption}" />
                    <ComboBox Width="92" ItemsSource="{Binding Ports}" IsEnabled="{Binding CanChangeSettings}" SelectedItem="{Binding SelectedPort}" VerticalContentAlignment="Center" ToolTip="Serial port the scope is connected to" />
                    <Button Style="{StaticResource ToolButton}" Click="RefreshPorts_Click" IsEnabled="{Binding CanChangeSettings}" ToolTip="Refresh the list of serial ports" Margin="2,0,14,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" />
                    </Button>
                    <TextBlock Text="Baud" Style="{StaticResource Caption}" />
                    <ComboBox Width="78" ItemsSource="{Binding BaudRates}" IsEnabled="{Binding CanChangeSettings}" SelectedItem="{Binding SelectedBaud}" Margin="0,0,14,0" VerticalContentAlignment="Center" ToolTip="Must match Print/Utility → I/O Menu → Baud Rate on the scope" />
                    <TextBlock Text="Handshake" Style="{StaticResource Caption}" />
                    <ComboBox Width="124" ItemsSource="{Binding Handshakes}" IsEnabled="{Binding CanChangeSettings}" SelectedItem="{Binding SelectedHandshake}" DisplayMemberPath="Label" Margin="0,0,16,0" VerticalContentAlignment="Center" ToolTip="Must match Print/Utility → I/O Menu → Handshake on the scope" />
                    <ToggleButton Style="{StaticResource ListenToggle}" IsChecked="{Binding IsListening}" ToolTip="Start or stop listening for plots from the scope" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,14,0" Background="#FAFAFA">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsCrtTheme}" Content="CRT" ToolTip="Green trace on a dark screen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" IsChecked="{Binding IsPaperTheme}" Content="Paper" ToolTip="Gray trace on white paper" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ToolButton}" Command="{x:Static local:AppCommands.FullScreen}" ToolTip="Full screen (F11, Esc to leave)" Margin="0,0,10,0">
                        <TextBlock Text="&#xE9A6;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{x:Static local:AppCommands.ExportSelected}" ToolTip="Export the selected captures (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusStrip" DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource SubtleTextBrush}" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                    <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" />
                    <TextBlock Text="  |  " Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActivityText}" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Captures sidebar + plot -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="Sidebar" Grid.Column="0" Background="{StaticResource PanelBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                    <TextBlock Text="Captures" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="right-click for options" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </DockPanel>
                <ListBox x:Name="CapturesList" ItemsSource="{Binding Captures}" SelectedItem="{Binding SelectedCapture}"
                         SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ContextMenu="{StaticResource CaptureMenu}"
                         PreviewMouseRightButtonDown="CapturesList_PreviewMouseRightButtonDown"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F2" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E3EEF9" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CC3EA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CaptureItem}">
                            <StackPanel ToolTip="{Binding ToolTipText}">
                                <Border CornerRadius="4" ClipToBounds="True" Height="132" Background="#ECECEC">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVisibility}}"
                                                Background="#CC16A34A" CornerRadius="3" Padding="6,1" Margin="6"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="LIVE" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,2,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" Margin="2,1,2,2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

            <Border x:Name="PlotFrame" Grid.Column="2" Margin="12" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <controls:PlotView x:Name="Plot" Builder="{Binding PlotBuilder}" Theme="{Binding CurrentTheme}" Placeholder="{Binding Placeholder}" />
                    <TextBlock x:Name="FullScreenHint" Visibility="Collapsed" Text="Esc to leave full screen" Foreground="#80FFFFFF" Background="#40000000"
                               Padding="8,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
