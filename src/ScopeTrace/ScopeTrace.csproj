<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\ScopeTrace.ico</ApplicationIcon>
    <!-- Keeps the WPF native libraries inside the exe when publishing a single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyTitle>ScopeTrace</AssemblyTitle>
    <Product>ScopeTrace</Product>
    <Version>1.0.2</Version>
    <Authors>ELPoupa</Authors>
    <Copyright>Copyright (c) 2026 ELPoupa</Copyright>
    <Description>Receives and draws HP-GL plots from HP 54600 series oscilloscopes over RS-232.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ScopeTrace.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

</Project>
